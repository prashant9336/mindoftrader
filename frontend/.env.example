# Supabase — get from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Server-only: never prefix with NEXT_PUBLIC_

# WebSocket backend — Railway URL after deploy (use wss:// in production)
NEXT_PUBLIC_WS_URL=wss://your-backend.railway.app

# Demo user UUID — must exist in the users table in Supabase
NEXT_PUBLIC_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
