# Vercel Postgres — Vercel injects these automatically after you link the DB.
# For local dev: copy from Vercel dashboard → Storage → your DB → .env.local tab
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...
POSTGRES_USER=...
POSTGRES_HOST=...
POSTGRES_PASSWORD=...
POSTGRES_DATABASE=...

# Dhan API — get from dhanhq.co → Open API → My Apps
# Access token expires every 30 days — regenerate and redeploy
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# WebSocket backend — Railway URL (use wss:// in production)
NEXT_PUBLIC_WS_URL=wss://your-backend.railway.app

# Demo user UUID — must exist in the users table
NEXT_PUBLIC_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
